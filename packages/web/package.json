{
	"name": "@yestheory.family/web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"analyze": "cross-env ANALYZE=true next build",
		"build": "yarn build:next && yarn build:scripts",
		"build:scripts": "tsc -p src/scripts/tsconfig.json",
		"build:next": "next build",
		"chromatic": "env-cmd -f .env.local chromatic",
		"codegen": "graphql-codegen",
		"dev": "yarn next",
		"payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
		"start": "next start",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"storybook:build:test": "storybook build --test",
		"lint": "biome check --write --unsafe",
		"lint:check": "biome check",
		"seed": "tsx src/scripts/dataseeder/main.ts",
		"types": "payload generate:types"
	},
	"devDependencies": {
		"@atmina/only-enum-types": "0.8.0",
		"@fontsource/roboto": "^5.1.0",
		"@graphql-codegen/cli": "5.0.2",
		"@graphql-codegen/near-operation-file-preset": "3.0.0",
		"@graphql-codegen/typescript-graphql-request": "^6.2.0",
		"@graphql-codegen/typescript-operations": "^4.2.3",
		"@next/bundle-analyzer": "16.1.6",
		"@next/eslint-plugin-next": "16.1.6",
		"@parcel/watcher": "^2.4.1",
		"@storybook/addon-essentials": "^8.3.3",
		"@storybook/addon-interactions": "^8.3.3",
		"@storybook/addon-links": "^8.3.3",
		"@storybook/nextjs": "^8.3.3",
		"@storybook/react": "^8.3.3",
		"@storybook/test": "8.3.3",
		"@swc/core": "^1.7.28",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/cookie": "0.6.0",
		"@types/eslint": "^8.56.12",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "8.10.2",
		"chromatic": "^11.10.4",
		"concurrently": "^8.2.2",
		"cross-env": "^7.0.3",
		"env-cmd": "^10.1.0",
		"eslint-config-next": "16.1.6",
		"eslint-plugin-storybook": "^0.9.0",
		"postcss": "^8.4.47",
		"storybook": "^8.3.3",
		"tailwindcss": "^4.2.1",
		"tsconfig-paths-webpack-plugin": "^4.1.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@atmina/formbuilder": "^2.1.1",
		"@ebay/nice-modal-react": "^1.2.13",
		"@heroicons/react": "^2.1.5",
		"@icons-pack/react-simple-icons": "^10.0.0",
		"@payloadcms/db-postgres": "3.79.0",
		"@payloadcms/next": "3.79.0",
		"@payloadcms/richtext-lexical": "^3.79.0",
		"@payloadcms/richtext-slate": "3.79.0",
		"@payloadcms/ui": "3.79.0",
		"@radix-ui/react-dialog": "^1.1.1",
		"@radix-ui/react-dropdown-menu": "^2.1.1",
		"cookie": "0.6.0",
		"framer-motion": "^11.8.0",
		"graphql": "16.9.0",
		"graphql-request": "^7.1.0",
		"graphql-scalars": "1.23.0",
		"next": "16.1.6",
		"node-cron": "^3.0.3",
		"payload": "3.79.0",
		"pg": "8.11.3",
		"pg-connection-string": "^2.7.0",
		"react": "19.2.4",
		"react-animate-height": "^3.2.3",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.53.0",
		"react-ssr-prepass": "1.5.0",
		"sharp": "0.33.5",
		"tailwind-merge": "^2.5.2",
		"typesense": "^1.8.2"
	},
	"license": "MIT",
	"prettier": "@atmina/linting/prettier"
}
